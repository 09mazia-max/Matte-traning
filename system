if 'submitted' not in st.session_state: st.session_state.submitted = False

# --- MAIN UI ---
def main():
    load_styles()
    
    # Header Area
    col_h1, col_h2 = st.columns([3, 1])
    with col_h1:
        st.title("🚀 MathOS Intelligence")
        st.caption("AI-driven matematisk plattform för avancerad inlärning")
    
    with col_h2:
        # Progress Tracking
        current_level = (st.session_state.xp // 100) + 1
        st.session_state.level = current_level
        progress = (st.session_state.xp % 100) / 100
        st.metric("Total XP", st.session_state.xp)
        st.write(f"**Level {st.session_state.level}**")
        st.progress(progress)

    st.divider()

    # Sidebar Controls
    with st.sidebar:
        st.header("Träningscenter")
        category = st.selectbox("Välj Område", ["Algebra", "Funktioner", "Geometri", "Statistik"])
        difficulty = st.select_slider("Svårighetsgrad", options=[1, 2, 3])
        
        if st.button("🔄 Generera Ny Uppgift", use_container_width=True):
            st.session_state.current_prob = get_new_problem(category, difficulty)
            st.session_state.submitted = False
            st.rerun()
        
        st.divider()
        st.subheader("Historik")
        if st.session_state.history:
            for h in st.session_state.history[-5:]:
                st.write(f"{'✅' if h['correct'] else '❌'} {h['cat']}")

    # Problem Display
    prob = st.session_state.current_prob
    
    st.markdown('<div class="math-card">', unsafe_allow_html=True)
    st.markdown(f'<span class="ai-badge">ID: #{prob.id}</span>', unsafe_allow_html=True)
    st.subheader(prob.instruction)
    
    if prob.latex:
        st.latex(prob.latex)
    
    if prob.graph_fn:
        x = np.linspace(-10, 10, 400)
        y = prob.graph_fn(x)
        fig = go.Figure()
        fig.add_trace(go.Scatter(x=x, y=y, line=dict(color='#4facfe', width=4)))
        fig.update_layout(height=400, margin=dict(l=0,r=0,b=0,t=0), plot_bgcolor='white',
                          xaxis=dict(zeroline=True, gridcolor='#eee'), yaxis=dict(zeroline=True, gridcolor='#eee'))
        st.plotly_chart(fig, use_container_width=True)

    # Input Area
    user_input = st.text_input("Ditt svar:", placeholder="Skriv in värdet...")
    
    col_btn1, col_btn2 = st.columns([1, 4])
    with col_btn1:
        submit = st.button("Kontrollera", type="primary")

    if submit or st.session_state.submitted:
        st.session_state.submitted = True
        try:
            # Flexible Verification
            clean_input = user_input.replace(",", ".").strip()
            is_correct = False
            
            if prob.ans_format == "int":
                is_correct = int(float(clean_input)) == int(prob.correct_ans)
            elif prob.ans_format == "float":
                is_correct = math.isclose(float(clean_input), float(prob.correct_ans), rel_tol=1e-2)
            
            if is_correct:
                st.success("🎉 Utmärkt! Rätt svar.")
                if submit: 
                    st.session_state.xp += 25
                    st.session_state.history.append({"cat": prob.category, "correct": True})
            else:
                st.error(f"Ojdå, det var inte helt rätt. Rätt svar: {prob.correct_ans}")
                if submit:
                    st.session_state.history.append({"cat": prob.category, "correct": False})
                
                # --- AI TUTOR STEPS ---
                with st.expander("🤖 Visa AI-förklaring (Steg-för-steg)"):
                    if prob.category == "Algebra":
                        steps = MathAI.solve_step_by_step(prob.latex)
                        for s in steps:
                            st.markdown(f'<div class="step-box">{s}</div>', unsafe_allow_html=True)
                    else:
                        st.info("AI-steg är för närvarande optimerade för Algebra. För grafer: Se skärningspunkten mellan linjen och y-axeln.")

        except Exception as e:
            st.warning("Vänligen mata in ett giltigt numeriskt svar.")

    st.markdown('</div>', unsafe_allow_html=True)

    # Footer
    if st.session_state.submitted:
        if st.button("Nästa utmaning →"):
            st.session_state.current_prob = get_new_problem(category, difficulty)
            st.session_state.submitted = False
            st.rerun()

if __name__ == "__main__":
    main()
