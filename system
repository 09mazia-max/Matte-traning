# --- MATH ENGINE & AI TUTOR ---
class MathAI:
    @staticmethod
    def solve_step_by_step(equation_str: str, variable: str = 'x'):
        """Symbolic AI that generates human-like steps for equations."""
        try:
            x = sp.symbols(variable)
            # Parse '2x + 5 = 15' into '2*x + 5 - 15'
            parts = equation_str.split('=')
            expr = parse_expr(parts[0].replace("^", "**"), transformations=standard_transformations+(implicit_multiplication_application,))
            rhs = parse_expr(parts[1], transformations=standard_transformations+(implicit_multiplication_application,))
            final_eq = expr - rhs
            
            steps = []
            steps.append(f"1. Analyserar ekvationen: ${sp.latex(expr)} = {sp.latex(rhs)}$")
            
            # Step 1: Simplify
            simplified = sp.simplify(final_eq)
            steps.append(f"2. Förenklar uttrycket: ${sp.latex(simplified)} = 0$")
            
            # Step 2: Isolate
            sol = sp.solve(final_eq, x)
            steps.append(f"3. Isolerar variabeln ${variable}$.")
            steps.append(f"4. Resultat: ${variable} = {sp.latex(sol[0])}$")
            return steps
        except:
            return ["AI kunde inte generera steg för denna specifika uppgift."]

# --- DATA MODELS ---
@dataclass
class Problem:
    id: int
    category: str
    level: int
    instruction: str
    latex: Optional[str] = None
    correct_ans: Any = None
    ans_format: str = "int" # int, sympy, float
    graph_fn: Optional[Callable] = None
    ai_hint: str = ""

# --- GENERATORS ---
def get_new_problem(cat: str, level: int) -> Problem:
    pid = random.randint(1000, 9999)
    if cat == "Algebra":
        x_val = random.randint(-12, 12)
        a = random.choice([2, 3, 4, 5, 10])
        b = random.randint(-20, 20)
        rhs = a * x_val + b
        eq_str = f"{a}x {'+' if b>=0 else ''} {b} = {rhs}"
        return Problem(pid, "Algebra", level, "Lös ekvationen:", eq_str, x_val, "int")
    
    elif cat == "Funktioner":
        # Linear Function Graphing
        m = random.randint(-5, 5)
        k = random.choice([-2, -1, 0.5, 1, 2])
        f_x = lambda x: k*x + m
        target_x = random.randint(-4, 4)
        return Problem(pid, "Funktioner", level, f"Bestäm värdet för f({target_x}) baserat på grafen:", 
                       f"f(x) = {k}x {'+' if m>=0 else ''} {m}", f_x(target_x), "float", graph_fn=f_x)
    
    return get_new_problem("Algebra", 1) # Default

# --- APP SESSION STATE ---
if 'xp' not in st.session_state: st.session_state.xp = 0
if 'level' not in st.session_state: st.session_state.level = 1
